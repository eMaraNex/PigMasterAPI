DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_name
DB_USER=db_user
DB_PASSWORD=
NODE_ENV=development
DB_URL=postgres://db_user:password@localhost:5432/db_name
DATABASE_URL=postgresql://db_user:password@localhost:5432/db_name
JWT_SECRET=your-secure-jwt-secret-1234567890
FIREBASE_PROJECT_ID=
ADMIN_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
USD_TO_KES_RATE=
PORT=4000
DB_SSLMODE=disable

# using SMTP for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@gmail.com
SMTP_PASS=password
DEFAULT_SENDER_EMAIL=user@gmail.com
BASE_URL=http://localhost:4000
PROD_BASE_URL=http://localhost:4000
RATE_LIMIT_WINDOW_MS=1*60*1000
RATE_LIMIT_MAX_REQUESTS=1000
PASSWORD=password

DEV_CLIENT_BASE_URL=http://localhost:4000
PROD_CLIENT_BASE_URL=https://domain.com


# Safaricom Configuration
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
BASE_URL=
# Base callback URL; the API appends a secret per-payment token: .../mpesa/callback/<token>
MPESA_CALLBACK_URL=https://domain.com/api/v1/payments/mpesa/callback
# Local M-Pesa testing: run `ngrok http 5000`, set MPESA_CALLBACK_URL to
# https://<your-id>.ngrok-free.app/api/v1/payments/mpesa/callback and TRUST_PROXY=true.
TRUST_PROXY=false
# Production: only accept callbacks from Safaricom (comma-separated). Leave empty for local ngrok tests.
# Check Daraja's documentation for the current list before enabling.
MPESA_CALLBACK_ALLOWED_IPS=

# NODE_OPTIONS=--experimental-vm-modules npx jest --runInBand --config jest.config.mjs --runTestsByPath ./tests/subscription-payments.test.mjs

CORS_ORIGIN=https://domain.com,http://localhost:3000
# Postgres pool size (use 1-2 on serverless hosts). Set DB_SSLMODE=disable only for a private-network DB.
DB_POOL_MAX=10
# Runs the M-Pesa reconciliation (every minute) and alert e-mails (hourly) in-process. Set false on serverless and call them from a cron job instead.
ENABLE_SCHEDULER=true
# Swagger UI at /api-docs is off in production unless this is true.
ENABLE_API_DOCS=false

# Exchange rates for currency conversion. Optional: without a key the free
# no-key endpoint (open.er-api.com, updated daily) is used.
EXCHANGE_RATE_API_KEY=

# Legal document versions (dates). Bump when the policy/terms change; must match the UI's
# NEXT_PUBLIC_PRIVACY_POLICY_VERSION / NEXT_PUBLIC_TERMS_VERSION.
PRIVACY_POLICY_VERSION=2026-10-25
TERMS_VERSION=2026-10-25

# Admin dashboard address, used in admin invite emails.
ADMIN_DASHBOARD_URL=http://localhost:3002
