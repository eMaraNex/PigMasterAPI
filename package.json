{
  "name": "pigmasterapi",
  "version": "1.0.0",
  "description": "Professional Pig Farm Management System Backend API",
  "main": "src/index.mjs",
  "type": "module",
  "scripts": {
    "start": "node --max-old-space-size=256 src/index.mjs",
    "dev": "nodemon --max-old-space-size=256 src/index.mjs",
    "migrate": "node-pg-migrate up --migrations-dir src/database/migrations --migrations-table pgmigrations --migration-file-extension .js --config migrations-config.js",
    "migrate:down": "node-pg-migrate down --migrations-dir src/database/migrations --migrations-table pgmigrations --migration-file-extension .js --config migrations-config.js",
    "seed": "node src/database/seed.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "redis": "^4.6.10",
    "sharp": "^0.32.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "twilio": "^4.19.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
